source "https://rubygems.org"

# Plain Jekyll 4 instead of the github-pages gem: the site is built by our own
# GitHub Actions workflow and uploaded as an artifact, so we do not need the
# github-pages version pins (Jekyll 3.9 / Liquid 4.0.3 do not run on Ruby >= 3.2).
gem "jekyll", "~> 4.4"

gem "tzinfo-data"
gem "wdm", "~> 0.1.0" if Gem.win_platform?

group :jekyll_plugins do
  gem "jekyll-remote-theme"   # needed for `remote_theme:` (was part of github-pages)
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jemoji"
  gem "jekyll-include-cache"
  gem "jekyll-spaceship"
end

gem "webrick", "~> 1.7"
